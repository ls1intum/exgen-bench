{
  "name": "exgen-bench",
  "version": "0.1.0",
  "description": "Run and evaluate systems that generate autograder-ready programming exercises.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "exgen": "./src/cli.ts"
  },
  "scripts": {
    "check": "bun run check:runtime && bun run format:check && bun run lint && bun run typecheck && bun run api:lint && bun run test:coverage",
    "api:lint": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint adapters/artemis/benchmark-api.openapi.yaml --extends=spec",
    "browser:test": "playwright test",
    "check:runtime": "bun -e 'const expected = (await Bun.file(\".bun-version\").text()).trim(); if (Bun.version !== expected) throw new Error(`Expected Bun ${expected}, received ${Bun.version}`)'",
    "cli": "bun run src/cli.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "schemas": "bun run scripts/export-schemas.ts",
    "site:serve": "bun run site/serve.ts",
    "site:validate": "bun run site/validate.ts",
    "smoke": "bun run scripts/smoke-full.ts",
    "test": "bun test ./tests/*.test.ts",
    "test:coverage": "bun test ./tests/*.test.ts --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "csv-stringify": "6.8.1",
    "json-canonicalize": "2.0.0",
    "p-queue": "9.3.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.0",
    "@redocly/cli": "2.40.0",
    "@types/bun": "1.3.14",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2"
  }
}
