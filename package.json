{
  "name": "exgen-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Run and evaluate systems that generate complete programming exercises.",
  "license": "MIT",
  "bin": {
    "exgen": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "browser:test": "playwright test",
    "check:runtime": "bun -e 'const expected = (await Bun.file(\".bun-version\").text()).trim(); if (Bun.version !== expected) throw new Error(`Expected Bun ${expected}, received ${Bun.version}`)'",
    "cli": "bun run src/cli.ts",
    "demo:generate": "bun run scripts/generate-site-demo.ts",
    "evaluators:check": "bun run scripts/pin-evaluators.ts --check",
    "evaluators:pin": "bun run scripts/pin-evaluators.ts",
    "lint": "oxlint --deny-warnings",
    "schemas": "bun run scripts/export-schemas.ts",
    "site:build": "bun run site/build.ts",
    "site:serve": "bun run site/serve.ts",
    "site:validate": "bun run site/validate.ts",
    "smoke": "bun run scripts/smoke-full.ts",
    "survey:demo": "bun run tools/tier3-expert-rating/demo/serve.ts",
    "survey:dev": "vite --config tools/tier3-expert-rating/web/vite.config.ts",
    "survey:example": "bun run tools/tier3-expert-rating/analysis/example.ts",
    "survey:browser-test": "EXGEN_SURVEY_TESTS=1 playwright test browser-tests/survey.spec.ts",
    "survey:instrument": "bun run tools/tier3-expert-rating/builder/instrument-doc.ts",
    "survey:server": "cd tools/tier3-expert-rating/server && ./gradlew check",
    "survey:web": "bun run tools/tier3-expert-rating/web/build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun check && bun check -p site && bun check -p browser-tests && bun check -p tools/tier3-expert-rating/web",
    "verify": "bun run check:runtime && bun fmt --check && bun lint && bun run typecheck && bun run evaluators:check && bun run test:coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@commander-js/extra-typings": "15.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@plantuml/core": "1.2026.9",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "csv-stringify": "6.8.1",
    "decimal.js": "10.6.0",
    "diff": "9.0.0",
    "driver.js": "1.10.2",
    "fflate": "0.8.3",
    "json-canonicalize": "2.0.0",
    "lucide-react": "1.28.0",
    "p-queue": "9.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.0",
    "recharts": "3.10.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "yaml": "2.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "oxlint": "1.89.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.4"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "hono": "4.13.11",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "systeminformation": "5.33.16",
    "undici": "7.30.1"
  }
}
