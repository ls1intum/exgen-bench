{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt-log.schema.json",
  "title": "Per-cell attempt log (attempts/<cell>.json)",
  "description": "EMITTED BY THE GENERATION EXPERIMENT for every (input, model, variant) cell, covering all k attempts INCLUDING not-saved ones. Artifacts are not exported for not-saved attempts, but their outcome + telemetry are. Enables save-rate, any-of-k / pass@k, H1 and H2a. Consumed by the evaluation harness.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "input_id": { "type": "string", "minLength": 1 },
    "model": { "$ref": "common.schema.json#/$defs/model" },
    "variant": { "$ref": "common.schema.json#/$defs/variant" },
    "k": { "type": "integer", "minimum": 1, "description": "Planned number of runs for this cell (the yield denominator). attempts SHOULD contain one entry per executed run." },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per executed run. run values MUST be unique and SHOULD lie in 1..k (invariant checked by the harness, not by JSON Schema).",
      "items": { "$ref": "#/$defs/attempt" }
    },
    "extra": { "type": "object", "additionalProperties": true }
  },
  "required": ["schema_version", "input_id", "model", "variant", "k", "attempts"],
  "additionalProperties": false,
  "$defs": {
    "attempt": {
      "type": "object",
      "properties": {
        "run": { "type": "integer", "minimum": 1, "description": "1-based run index within the cell." },
        "outcome": { "$ref": "common.schema.json#/$defs/attemptOutcome" },
        "candidate_id": { "type": ["string", "null"], "description": "Links to corpus/candidates/<candidate_id>/ for saved outcomes; null/omitted otherwise. REQUIRED (non-null) when outcome is SUCCESS or NEEDS_REVIEW." },
        "verified": { "type": "boolean", "description": "Hyperion mechanical verdict (mechanically_verified) for this attempt." },
        "failure_reason": { "type": ["string", "null"], "description": "Short reason for NOT_SAVED / PARTIAL (e.g. 'template passed a behavioural test', 'provider error')." },
        "efficiency": { "$ref": "common.schema.json#/$defs/efficiency" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      },
      "required": ["run", "outcome", "efficiency"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "outcome": { "enum": ["SUCCESS", "NEEDS_REVIEW"] } }, "required": ["outcome"] },
          "then": { "required": ["candidate_id"], "properties": { "candidate_id": { "type": "string", "minLength": 1 } } }
        }
      ]
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "input_id": "itp-2024-recursion-01",
      "model": { "id": "gpt-oss-120b", "provider": "openai" },
      "variant": "full-agentic",
      "k": 5,
      "attempts": [
        { "run": 1, "outcome": "SUCCESS", "candidate_id": "itp-2024-recursion-01__gpt-oss-120b__full-agentic__r01", "verified": true,
          "efficiency": { "total_tokens": 198000, "turns": 11, "agent_status": "COMPLETED", "duration_s": 388.2, "cost_usd": 0.55 } },
        { "run": 2, "outcome": "NOT_SAVED", "verified": false, "failure_reason": "A behavioural task-bound test passed on the template.",
          "efficiency": { "total_tokens": 240000, "turns": 40, "agent_status": "BUDGET_EXHAUSTED", "duration_s": 720.0, "cost_usd": 0.67 } },
        { "run": 3, "outcome": "NEEDS_REVIEW", "candidate_id": "itp-2024-recursion-01__gpt-oss-120b__full-agentic__r03", "verified": true,
          "efficiency": { "total_tokens": 222000, "turns": 14, "agent_status": "COMPLETED", "duration_s": 437.5, "cost_usd": 0.62 } },
        { "run": 4, "outcome": "NOT_SAVED", "verified": false, "failure_reason": "Solution did not compile.",
          "efficiency": { "total_tokens": 150000, "turns": 9, "agent_status": "ERROR", "duration_s": 210.4, "cost_usd": 0.41 } },
        { "run": 5, "outcome": "SUCCESS", "candidate_id": "itp-2024-recursion-01__gpt-oss-120b__full-agentic__r05", "verified": true,
          "efficiency": { "total_tokens": 205000, "turns": 12, "agent_status": "COMPLETED", "duration_s": 402.1, "cost_usd": 0.57 } }
      ]
    }
  ]
}
