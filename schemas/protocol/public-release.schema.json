{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ls1intum/exgen-bench/main/schemas/protocol/public-release.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["exploratory", "illustrative"]
    },
    "designation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["exploratory", "illustrative"]
        }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "systems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "planned_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["target", "dataset", "cases", "systems", "planned_attempts", "budget"],
      "additionalProperties": false
    },
    "systems": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "factors": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "planned": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "started": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quality_failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "abstained": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "generation_failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "budget_exceeded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "budget_unverifiable": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "infrastructure_failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "not_started": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "decision_metrics": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "cost": {
                    "type": "object",
                    "properties": {
                      "estimate": {
                        "type": "number",
                        "minimum": 0
                      },
                      "currency": {
                        "type": "string",
                        "const": "USD"
                      },
                      "statistic": {
                        "type": "string",
                        "const": "mean per planned attempt"
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "pricing_basis": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "estimate",
                      "currency",
                      "statistic",
                      "denominator",
                      "pricing_basis"
                    ],
                    "additionalProperties": false
                  },
                  "latency": {
                    "type": "object",
                    "properties": {
                      "estimate": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "const": "seconds"
                      },
                      "statistic": {
                        "type": "string",
                        "const": "median among started attempts"
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["estimate", "unit", "statistic", "denominator"],
                    "additionalProperties": false
                  }
                },
                "required": ["cost"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "cost": {
                    "type": "object",
                    "properties": {
                      "estimate": {
                        "type": "number",
                        "minimum": 0
                      },
                      "currency": {
                        "type": "string",
                        "const": "USD"
                      },
                      "statistic": {
                        "type": "string",
                        "const": "mean per planned attempt"
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "pricing_basis": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "estimate",
                      "currency",
                      "statistic",
                      "denominator",
                      "pricing_basis"
                    ],
                    "additionalProperties": false
                  },
                  "latency": {
                    "type": "object",
                    "properties": {
                      "estimate": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string",
                        "const": "seconds"
                      },
                      "statistic": {
                        "type": "string",
                        "const": "median among started attempts"
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["estimate", "unit", "statistic", "denominator"],
                    "additionalProperties": false
                  }
                },
                "required": ["latency"],
                "additionalProperties": false
              }
            ]
          },
          "primary": {
            "type": "object",
            "properties": {
              "estimate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "denominator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "interval_low": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "interval_high": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "interval_method": {
                "type": "string",
                "minLength": 1
              },
              "planned_sensitivity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "started_sensitivity": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "estimate",
              "numerator",
              "denominator",
              "interval_low",
              "interval_high",
              "interval_method",
              "planned_sensitivity"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "factors",
          "color",
          "planned",
          "started",
          "completed",
          "accepted",
          "quality_failed",
          "abstained",
          "infrastructure_failed",
          "primary"
        ],
        "additionalProperties": false
      }
    },
    "primary_contrast": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "system_a": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "system_b": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "estimate": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "interval_low": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "interval_high": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "system_a",
            "system_b",
            "estimate",
            "interval_low",
            "interval_high",
            "unit",
            "method",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "systems": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "accepted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "quality_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "abstained": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "generation_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "budget_exceeded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "budget_unverifiable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "infrastructure_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "not_started": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "accepted",
                "denominator",
                "quality_failed",
                "abstained",
                "infrastructure_failed"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "title", "brief", "tags", "systems"],
        "additionalProperties": false
      }
    },
    "metrics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": ["confirmatory", "secondary", "exploratory"]
          },
          "construct": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": ["boolean", "proportion", "count", "number", "string"]
          },
          "allowed_values": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "valid_range": {
            "type": "object",
            "properties": {
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            },
            "required": ["minimum", "maximum"],
            "additionalProperties": false
          },
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "status_mapping": {
            "type": "string",
            "minLength": 1
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["planned", "completed"]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "pattern": "^https?:\\/\\/[^\\s]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": ["uri"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["status", "method", "evidence"],
            "additionalProperties": false
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "tier",
          "construct",
          "unit",
          "value_type",
          "direction",
          "population",
          "denominator",
          "status_mapping",
          "implementation",
          "evidence",
          "validation",
          "limitations"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "value_type": {
                  "const": "string"
                }
              },
              "required": ["value_type"]
            },
            "then": {
              "required": ["allowed_values"]
            },
            "else": {
              "not": {
                "required": ["allowed_values"]
              }
            }
          },
          {
            "properties": {
              "allowed_values": {
                "uniqueItems": true
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "downloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^\\.\\/(?:(?!\\.{1,2}(?:\\/|$))[A-Za-z0-9._~-]+)(?:\\/(?!\\.{1,2}(?:\\/|$))[A-Za-z0-9._~-]+)*$"
          }
        },
        "required": ["id", "label", "description", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "release_version",
    "source_manifest_sha256",
    "title",
    "status",
    "designation",
    "published_at",
    "summary",
    "notice",
    "scope",
    "systems",
    "primary_contrast",
    "cases",
    "metrics",
    "limitations",
    "provenance",
    "downloads"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "exploratory"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "designation": {
            "properties": {
              "status": {
                "const": "exploratory"
              }
            }
          },
          "source_manifest_sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "illustrative"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "designation": {
            "properties": {
              "status": {
                "const": "illustrative"
              }
            }
          }
        }
      }
    }
  ]
}
