{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ls1intum/exgen-bench/main/schemas/protocol/generation-response.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "2"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "abstained", "infra_failed"]
    },
    "artifacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["role", "path"],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "default": [],
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": ["event_journal", "checkpoint", "trace", "provenance", "other"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "visibility": {
            "default": "restricted",
            "type": "string",
            "enum": ["public", "restricted"]
          }
        },
        "required": ["id", "kind", "path", "media_type", "sha256", "size_bytes"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "event_journal"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "required": ["record_count"],
              "properties": {
                "media_type": {
                  "const": "application/x-ndjson"
                }
              }
            }
          }
        ]
      }
    },
    "capture": {
      "type": "object",
      "properties": {
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial", "none"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["completeness"],
      "additionalProperties": false
    },
    "message": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["provider", "id"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "requested_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "seed_status": {
          "type": "string",
          "enum": ["honored", "not_honored", "unsupported", "unverifiable"]
        },
        "effective_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "effective_parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "effective_limits": {
          "$ref": "#/$defs/EffectiveLimits"
        },
        "observed_factors": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "provider_request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_request_ids_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "requested_seed",
        "seed_status",
        "effective_parameters",
        "provider_request_ids",
        "provider_request_ids_complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "seed_status": {
                "const": "honored"
              }
            },
            "required": ["seed_status"]
          },
          "then": {
            "required": ["effective_seed"]
          }
        }
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["protocol_version", "status", "capture"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["artifacts"],
        "properties": {
          "artifacts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture": {
            "properties": {
              "completeness": {
                "const": "none"
              }
            },
            "required": ["completeness"]
          }
        },
        "required": ["capture"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "EffectiveLimits": {
      "type": "object",
      "properties": {
        "wall_time_ms": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["value", "source"],
              "additionalProperties": false
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "model_calls": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["value", "source"],
              "additionalProperties": false
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "tool_calls": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["value", "source"],
              "additionalProperties": false
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["value", "source"],
              "additionalProperties": false
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["value", "source"],
              "additionalProperties": false
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["value", "source"],
              "additionalProperties": false
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "source": {
                  "type": "string",
                  "enum": ["system_reported", "system_configured"]
                }
              },
              "required": ["amount", "currency", "source"],
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/CostLimit"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CostLimit": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    }
  }
}
