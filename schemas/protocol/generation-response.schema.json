{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ls1intum/exgen-bench/main/schemas/protocol/generation-response.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "abstained", "infra_failed"]
    },
    "artifacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["role", "path"],
        "additionalProperties": false
      }
    },
    "capture": {
      "type": "object",
      "properties": {
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial", "none"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["completeness"],
      "additionalProperties": false
    },
    "message": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["provider", "id"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "requested_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "seed_status": {
          "type": "string",
          "enum": ["honored", "not_honored", "unsupported", "unverifiable"]
        },
        "effective_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "effective_parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "provider_request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_request_ids_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "requested_seed",
        "seed_status",
        "effective_parameters",
        "provider_request_ids",
        "provider_request_ids_complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "seed_status": {
                "const": "honored"
              }
            },
            "required": ["seed_status"]
          },
          "then": {
            "required": ["effective_seed"]
          }
        }
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["protocol_version", "status", "artifacts", "capture", "extensions"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture": {
            "properties": {
              "completeness": {
                "const": "none"
              }
            },
            "required": ["completeness"]
          }
        },
        "required": ["capture"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
