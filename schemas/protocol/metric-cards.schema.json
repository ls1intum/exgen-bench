{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ls1intum/exgen-bench/main/schemas/protocol/metric-cards.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "metrics": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": ["confirmatory", "secondary", "exploratory"]
          },
          "construct": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": ["boolean", "proportion", "count", "number", "string"]
          },
          "allowed_values": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "valid_range": {
            "type": "object",
            "properties": {
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            },
            "required": ["minimum", "maximum"],
            "additionalProperties": false
          },
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "status_mapping": {
            "type": "string",
            "minLength": 1
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["planned", "completed"]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "pattern": "^https?:\\/\\/[^\\s]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": ["uri"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["status", "method"],
            "additionalProperties": false
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "tier",
          "construct",
          "unit",
          "value_type",
          "direction",
          "population",
          "denominator",
          "status_mapping",
          "implementation",
          "evidence",
          "validation",
          "limitations"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "value_type": {
                  "const": "string"
                }
              },
              "required": ["value_type"]
            },
            "then": {
              "required": ["allowed_values"]
            },
            "else": {
              "not": {
                "required": ["allowed_values"]
              }
            }
          },
          {
            "properties": {
              "allowed_values": {
                "uniqueItems": true
              }
            }
          }
        ]
      }
    }
  },
  "required": ["schema_version", "metrics"],
  "additionalProperties": false
}
