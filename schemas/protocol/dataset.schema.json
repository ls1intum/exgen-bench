{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ls1intum/exgen-bench/main/schemas/protocol/dataset.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "default": [],
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["synthetic", "adapted", "collected"]
              },
              "source_uri": {
                "type": "string",
                "pattern": "^https?:\\/\\/[^\\s]+$"
              },
              "citation": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "first_public_at": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": ["kind", "created_at"],
            "additionalProperties": false
          },
          "authors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "orcid": {
                  "type": "string",
                  "pattern": "^https:\\/\\/orcid\\.org\\/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "exposure": {
            "type": "object",
            "properties": {
              "generator_visible": {
                "type": "boolean",
                "const": true
              },
              "known_public": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["generator_visible", "known_public", "notes"],
            "additionalProperties": false
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["id", "title", "brief", "origin", "authors", "license", "exposure"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "properties": {
                    "kind": {
                      "enum": ["adapted", "collected"]
                    }
                  },
                  "required": ["kind"]
                }
              },
              "required": ["origin"]
            },
            "then": {
              "properties": {
                "origin": {
                  "required": ["source_uri", "citation"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "exposure": {
                  "properties": {
                    "known_public": {
                      "const": true
                    }
                  },
                  "required": ["known_public"]
                }
              },
              "required": ["exposure"]
            },
            "then": {
              "properties": {
                "origin": {
                  "required": ["first_public_at"]
                }
              }
            }
          }
        ]
      }
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["schema_version", "id", "version", "title", "description", "license", "cases"],
  "additionalProperties": false
}
