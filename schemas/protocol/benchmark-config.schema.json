{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ls1intum/exgen-bench/main/schemas/protocol/benchmark-config.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/TargetParameters"
        }
      },
      "required": ["id", "version", "revision", "parameters"],
      "additionalProperties": false
    },
    "systems": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "command"
                  },
                  "command": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "env": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["type", "command"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "container"
                  },
                  "engine": {
                    "default": "docker",
                    "type": "string",
                    "enum": ["docker", "podman"]
                  },
                  "image": {
                    "type": "string",
                    "pattern": "@sha256:[a-f0-9]{64}$"
                  },
                  "command": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "env": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "network": {
                    "default": "none",
                    "type": "string",
                    "enum": ["none", "bridge"]
                  },
                  "read_only": {
                    "default": true,
                    "type": "boolean",
                    "const": true
                  },
                  "pids_limit": {
                    "default": 256,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "memory_mb": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cpus": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "user": {
                    "type": "string",
                    "pattern": "^[1-9]\\d*:[1-9]\\d*$"
                  }
                },
                "required": ["type", "image", "memory_mb", "cpus", "user"],
                "additionalProperties": false
              }
            ]
          },
          "factors": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DeclaredFactor"
                },
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              ]
            }
          },
          "parameters": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "attestation": {
            "type": "object",
            "properties": {
              "deployment_deviations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/DeploymentDeviation"
                }
              }
            },
            "required": ["deployment_deviations"],
            "additionalProperties": false
          }
        },
        "required": ["id", "name", "version", "revision", "runtime", "attestation"],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_model_calls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_tool_calls": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_input_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_total_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_cost": {
          "$ref": "#/$defs/CostLimit"
        },
        "enforcement": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "wall_time_ms",
              "model_calls",
              "tool_calls",
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "cost"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["harness", "system"]
          }
        }
      },
      "required": ["wall_time_ms"],
      "additionalProperties": false
    },
    "trials": {
      "type": "object",
      "properties": {
        "replicates": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "base_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": ["replicates", "base_seed"],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "method": {
          "default": "case_clustered_paired_bootstrap",
          "type": "string",
          "enum": ["case_clustered_bootstrap", "case_clustered_paired_bootstrap"]
        },
        "estimand": {
          "default": "end_to_end_within_budget_strict_success_rate_difference",
          "type": "string",
          "enum": [
            "end_to_end_within_budget_strict_success_rate",
            "end_to_end_within_budget_strict_success_rate_difference"
          ]
        },
        "bootstrap_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "contrasts": {
          "default": [],
          "maxItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system_a": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "system_b": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "required": ["system_a", "system_b"],
            "additionalProperties": false
          }
        },
        "design": {
          "type": "object",
          "properties": {
            "smallest_meaningful_effect": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "power": {
              "default": 0.8,
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "assumed_success_rate": {
              "default": 0.5,
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "assumed_arm_correlation": {
              "default": 0.5,
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "assumed_intra_case_correlation": {
              "default": 0.5,
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            }
          },
          "required": ["smallest_meaningful_effect"],
          "additionalProperties": false
        },
        "registration": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "registered_at": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "pattern": "T\\d{2}:\\d{2}:\\d{2}"
                }
              ],
              "format": "date-time"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "amendment_uri": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            }
          },
          "required": ["uri", "registered_at", "revision"],
          "additionalProperties": false
        }
      },
      "required": ["bootstrap_seed", "bootstrap_resamples", "confidence_level"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "results_dir": {
          "default": ".exgen/runs",
          "type": "string",
          "minLength": 1
        },
        "concurrency": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_log_bytes": {
          "default": 10485760,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "dataset",
    "target",
    "systems",
    "budget",
    "trials",
    "analysis",
    "execution"
  ],
  "additionalProperties": false,
  "$defs": {
    "TargetParameters": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "build_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "case_overrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "build_system": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "additionalProperties": {}
          }
        }
      },
      "required": ["language"],
      "additionalProperties": {}
    },
    "DeclaredFactor": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "control": {
          "type": "string",
          "enum": ["requested", "observed", "declared"]
        }
      },
      "required": ["value", "control"],
      "additionalProperties": false
    },
    "DeploymentDeviation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_uri": {
          "type": "string",
          "pattern": "^https?:\\/\\/[^\\s]+$"
        }
      },
      "required": ["id", "description"],
      "additionalProperties": false
    },
    "CostLimit": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    }
  }
}
