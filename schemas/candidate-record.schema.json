{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-record.schema.json",
  "title": "Candidate record (record.json)",
  "description": "EMITTED BY THE GENERATION EXPERIMENT for every SAVED exercise (outcome SUCCESS or NEEDS_REVIEW). Lives at corpus/candidates/<candidate_id>/record.json alongside the four artifacts. Consumed by the Tier-1 evaluation harness.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0", "description": "Contract version of this record schema." },
    "candidate_id": { "type": "string", "minLength": 1, "description": "Stable unique id; SHOULD equal the containing directory name and match the attempt-log entry that saved it." },
    "input_id": { "type": "string", "minLength": 1, "description": "References corpus/inputs/<input_id>/spec.json." },
    "model": { "$ref": "common.schema.json#/$defs/model" },
    "variant": { "$ref": "common.schema.json#/$defs/variant" },
    "run": { "type": "integer", "minimum": 1, "description": "1-based run index within this (input, model, variant) cell." },
    "generation_mode": { "type": "string", "enum": ["generate", "adapt"], "default": "generate", "description": "Whole-exercise generation vs adaptation of an existing exercise." },
    "programming_language": { "$ref": "common.schema.json#/$defs/programmingLanguage" },
    "project_type": { "$ref": "common.schema.json#/$defs/projectType" },
    "package_name": { "type": "string", "description": "Java package of the assignment sources (exercise.getPackageName()); used by the oracle/layout checks." },
    "decoding": {
      "type": "object",
      "description": "Sampling configuration.",
      "properties": {
        "temperature": { "type": "number", "minimum": 0 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "seed": { "type": ["integer", "null"] }
      },
      "required": ["temperature"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "description": "The four exercise artifacts, relative to this candidate directory.",
      "properties": {
        "problem_statement": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "template": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "solution": { "$ref": "common.schema.json#/$defs/artifactRef" },
        "tests": { "$ref": "common.schema.json#/$defs/artifactRef" }
      },
      "required": ["problem_statement", "template", "solution", "tests"],
      "additionalProperties": false
    },
    "hyperion_outcome": { "$ref": "common.schema.json#/$defs/savedOutcome" },
    "hyperion_verdict": {
      "type": "object",
      "description": "Hyperion's own mechanical verdict (DifferentialVerificationService.VerificationResult). The harness re-computes #1-#3 independently and asserts agreement.",
      "properties": {
        "mechanically_verified": { "type": "boolean" },
        "solution_passed": { "type": "boolean" },
        "template_failed": { "type": "boolean", "description": "Every non-structural gradable test failed on the template." },
        "test_count": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Actionable rejection / review reasons, if any." }
      },
      "required": ["mechanically_verified", "solution_passed", "template_failed", "test_count"],
      "additionalProperties": false
    },
    "structural_test_names": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Seeded structural test METHOD names that MAY legitimately pass on the template (StructuralOracleSeedingService). Required (may be empty) so the harness applies the correct oracle for #3."
    },
    "gate_test_names": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Build/compile/configure gate test names exempt from the template-fails rule (BuildGateTestNames). Empty if none."
    },
    "test_inventory": {
      "type": "array",
      "description": "Optional full test inventory with classification; enriches #3/#6/#10/#12.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Test method name as reported by the runner (the [task] binding key)." },
          "type": { "type": "string", "enum": ["structural", "behavioral", "gate"] },
          "task": { "type": "string", "description": "Bound [task] title, if any." }
        },
        "required": ["name", "type"],
        "additionalProperties": false
      }
    },
    "efficiency": { "$ref": "common.schema.json#/$defs/efficiency" },
    "review_findings_count": { "type": "integer", "minimum": 0, "description": "Number of quality-review findings attached (NEEDS_REVIEW). Excluded-tier metadata (LLM consistency review); NOT a Tier-1 metric, recorded only for correlation." },
    "generated_at": { "type": "string", "format": "date-time" },
    "artemis_commit": { "$ref": "common.schema.json#/$defs/vcsCommit", "description": "Artemis/Hyperion commit that generated and verified this candidate (pin for reproducibility)." },
    "generation_config": { "type": "object", "additionalProperties": true, "description": "Provenance of the run config, e.g. context_window_tokens, max_turns, max_tokens_per_job." },
    "extra": { "type": "object", "additionalProperties": true, "description": "Non-standard fields escape hatch." }
  },
  "required": [
    "schema_version", "candidate_id", "input_id", "model", "variant", "run",
    "programming_language", "project_type", "package_name", "artifacts",
    "hyperion_outcome", "hyperion_verdict", "structural_test_names", "efficiency"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": "1.0",
      "candidate_id": "itp-2024-recursion-01__gpt-oss-120b__full-agentic__r03",
      "input_id": "itp-2024-recursion-01",
      "model": { "id": "gpt-oss-120b", "provider": "openai", "display_name": "GPT-OSS 120B" },
      "variant": "full-agentic",
      "run": 3,
      "generation_mode": "generate",
      "programming_language": "JAVA",
      "project_type": "MAVEN_MAVEN",
      "package_name": "de.tum.in.ase",
      "decoding": { "temperature": 1.0, "seed": 42 },
      "artifacts": {
        "problem_statement": { "path": "problem-statement.md", "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" },
        "template": { "path": "template/", "vcs_commit": "a1b2c3d" },
        "solution": { "path": "solution/", "vcs_commit": "e4f5a6b" },
        "tests": { "path": "tests/", "vcs_commit": "0c1d2e3" }
      },
      "hyperion_outcome": "NEEDS_REVIEW",
      "hyperion_verdict": {
        "mechanically_verified": true,
        "solution_passed": true,
        "template_failed": true,
        "test_count": 5,
        "reasons": ["Statement may under-specify the base case."]
      },
      "structural_test_names": ["testClassStructure"],
      "gate_test_names": ["testCompiles"],
      "test_inventory": [
        { "name": "testClassStructure", "type": "structural" },
        { "name": "testFactorialBaseCase", "type": "behavioral", "task": "Implement factorial" },
        { "name": "testFactorialRecursive", "type": "behavioral", "task": "Implement factorial" }
      ],
      "efficiency": {
        "prompt_tokens": 180000, "completion_tokens": 42000, "total_tokens": 222000,
        "model_calls": 12, "turns": 14, "repair_iterations": 3,
        "agent_status": "COMPLETED", "duration_s": 437.5, "cost_usd": 0.62
      },
      "review_findings_count": 1,
      "generated_at": "2026-07-20T14:32:10Z",
      "artemis_commit": "2019aa2db3901722c8ff1d0030d391260a4b31ed"
    }
  ]
}
