{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "adapters/**/*.ts",
      "analysis/**/*.ts",
      "evaluators/**/*.ts",
      "evaluators/**/*.yaml",
      "evaluators/**/*.json",
      "scripts/**/*.ts",
      "site/**/*.ts",
      "site/**/*.tsx",
      "site/**/*.js",
      "site/**/*.css",
      "site/**/*.html",
      "site/**/*.json",
      "tests/**/*.ts",
      "examples/**/*.ts",
      "examples/**/*.yaml",
      "schemas/protocol/**/*.json",
      "package.json",
      "tsconfig.json",
      "site/tsconfig.json",
      "biome.json",
      "!site/data",
      "!site/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
