# The variables of the deployment's GitHub environment, which the deployment workflow writes to
# .env next to compose.yaml. Copy to .env to run the stack by hand; .env is never committed.
IMAGE_TAG=sha-0000000
SURVEY_HOST=survey.example.org
POSTGRES_PASSWORD=change-me
# A URL to link to, or a Markdown file in LEGAL_DIRECTORY, mounted at /legal.
SURVEY_LEGAL_IMPRINT=https://example.org/imprint
SURVEY_LEGAL_PRIVACY=/legal/privacy.md
SURVEY_LEGAL_ACCESSIBILITY=
# Defaults: ./study and ./legal next to compose.yaml.
STUDY_DIRECTORY=./study
LEGAL_DIRECTORY=./legal
